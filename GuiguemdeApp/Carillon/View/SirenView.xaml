<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GuiguemdeApp.Carillon.View.SirenView"
             x:Name="Page">

       <Grid Padding="30,10"
             RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
             RowSpacing="15">

        <Label Grid.Row="0"
               Text="Sirène"
               Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Grid.Row="1"
               Text="Nouvelle sirène"
               Style="{StaticResource SubHeadline}"
               SemanticProperties.HeadingLevel="Level2" />

        <Entry Grid.Row="2"
               Placeholder="Nom"
               Text="{Binding Name}" />

        <TimePicker Grid.Row="3"
                    Time="{Binding Time}"
                    Format="HH:mm" />

        <Grid Grid.Row="4">
               <Grid Padding="20,10"
                  ColumnDefinitions="*,*"   
                     ColumnSpacing="20"
                     >
                      <Button Grid.Column="0"
                              Text="Valider"
                              Command="{Binding AddAlarmCommand}" 
                      />
        
                      <Button Grid.Column="1"
                              Text="Supprimer"
                              Command="{Binding DeleteAlarmCommand}" 
                      />
               </Grid>
        </Grid>

        <CollectionView Grid.Row="5"
                        ItemsSource="{Binding Alarms}"
                        SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
               
                   <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                 <VerticalStackLayout Grid.Column="0"
                                                      Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold" />

                                        <Label Text="{Binding Date, StringFormat='{}{0:HH:mm}'}" />
                                 </VerticalStackLayout>

                                 
                                 <Switch Grid.Column="1"
                                         VerticalOptions="Center"
                                         IsToggled="{Binding IsActive, Mode=TwoWay}"
                                         x:Name="AlarmSwitch">
                                        <Switch.Behaviors>
                                               <toolkit:EventToCommandBehavior
                                                      EventName="Toggled"
                                                      BindingContext="{Binding BindingContext, Source={x:Reference AlarmSwitch}}"
                                                      Command="{Binding BindingContext.ToggleAlarmCommand, Source={x:Reference Page}}"
                                                      CommandParameter="{Binding .}" />
                                        </Switch.Behaviors>
                                 </Switch>

                          </Grid>
                   </DataTemplate>

            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>